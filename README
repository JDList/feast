This is the FEAST software package

FEAST stands for Finite Element Analysis for Simulations and Training

---------------------------------------------------------------------

FEASTs main purpose is to be a way of generating large datasets of solved simulations for ML and other usecases.

Its probably not very good icl.

Install with commands:

git clone --recursive-submodules https://github.com/JDList/feast.git
cd feast
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
cmake --build build -j

From there python package can be used by including "import feast" in your python file and PYTHONPATH=PATHTOFEAST/feast/python/ before running file or from within this filepath.

~~~~~~~~~~~~~~ Example Python file usage ~~~~~~~~~~~~~~~~~~~~~~~

import feast

# GEOMETRY

cuboid = feast.Cuboid(10.0, 5.0, 1.0) #x,y,z lengths
geometry = feast.CuboidBuilder().build(cuboid)

# MESHING

mesher = feast.StructuredTetMesher(0.1)
build = mesher.generate(geometry)

mesh = build.mesh
groups = build.groups

# BOUNDARY CONDITIONS

region_bcs = feast.RegionBoundaryConditionSet()
for dof in (0, 1, 2):
    region_bcs.addRegionDirichlet("lowx", dof, 0.0)
#region_bcs.addRegionNeumann("lowx", 0, 1000.0)
region_bcs.addRegionNeumann("highx", 0, -1000.0)

resolved_bcs = feast.BoundaryConditionResolver.resolve(region_bcs, build)

# DOF MAP / MATERIALS / ELEMENT STIFFNESS

dof_map = feast.DofMap()
dof_map.resize(len(mesh.nodes()), 3)

material = feast.LinearElastic(210e7, 0.3)

# SOLVE

solver = feast.EigenCGSolver()
kernel = feast.Kernel(solver)

result = kernel.solveLinearStatic(
        mesh,
        dof_map,
        resolved_bcs,
        [material]
        )


# POSTPROCESSING

pp = feast.PostProcessor.process(
        result,
        mesh,
        dof_map,
        [material],
        )

# ALL POSSIBLE OUTPUTS FROM POSTPROCESSING

print("max displacement x:", pp.displacement.x.summary.max)
print("mean displacement x:", pp.displacement.x.summary.mean)
print("min displacement x:", pp.displacement.x.summary.min)
print("range displacement x:", pp.displacement.x.summary.range)
print("std displacement x:", pp.displacement.x.summary.standardDeviation)

print("max displacement y:", pp.displacement.y.summary.max)
print("mean displacement y:", pp.displacement.y.summary.mean)
print("min displacement y:", pp.displacement.y.summary.min)
print("range displacement y:", pp.displacement.y.summary.range)
print("std displacement y:", pp.displacement.y.summary.standardDeviation)

print("max displacement z:", pp.displacement.z.summary.max)
print("mean displacement z:", pp.displacement.z.summary.mean)
print("min displacement z:", pp.displacement.z.summary.min)
print("range displacement z:", pp.displacement.z.summary.range)
print("std displacement z:", pp.displacement.z.summary.standardDeviation)

print("max displacement magnitude:", pp.displacement.magnitude.summary.max)
print("mean displacement magnitude:", pp.displacement.magnitude.summary.mean)
print("min displacement magnitude:", pp.displacement.magnitude.summary.min)
print("range displacement magnitude:", pp.displacement.magnitude.summary.range)
